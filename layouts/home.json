{{- /*
  搜索索引：输出到 /index.json，由 site.js 在**打开搜索面板时**才 fetch。

  为什么截断：正文塞整篇会让索引膨胀到几 MB；截到 2000 字后一篇约 4KB，
  100 篇 ≈ 400KB，而且只有打开面板才拉，不影响首屏。

  站点需要在 hugo.toml 里给 home 加 json 输出（主题无法代替，输出格式只能在站点声明）：
    [outputs]
      home = ['html', 'rss', 'json']
*/ -}}
{{- $pages := where site.RegularPages "Type" "in" site.MainSections -}}
{{- $index := slice -}}
{{- range $pages -}}
  {{- $tags := slice -}}
  {{- range .GetTerms "tags" }}{{ $tags = $tags | append .Title }}{{ end -}}
  {{- $cats := slice -}}
  {{- range .GetTerms "categories" }}{{ $cats = $cats | append .Title }}{{ end -}}
  {{- $index = $index | append (dict
      "title" .Title
      "url" .RelPermalink
      "date" (.Date.Format "2006-01-02")
      "tags" $tags
      "categories" $cats
      "content" (.Plain | replaceRE `\s+` " " | truncate 2000)
  ) -}}
{{- end -}}
{{- $index | jsonify -}}
